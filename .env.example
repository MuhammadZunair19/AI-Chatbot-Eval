# Ollama exposes an OpenAI-compatible API and accepts any non-empty key.
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1

# Set a real evaluator model to enable live RAGAS scoring. Leave blank to skip it.
RAGAS_EVALUATOR_MODEL=
# Response relevance additionally needs an embeddings model (for example nomic-embed-text).
RAGAS_EMBEDDING_MODEL=

TOP_K=3
RETRIEVAL_MIN_SCORE=0.10
LATENCY_THRESHOLD_MS=5000
LLM_TIMEOUT_SECONDS=60

