# Ollama exposes an OpenAI-compatible API and accepts any non-empty key.
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1

# Ollama models used by RAGAS correctness, relevance, and faithfulness metrics.
RAGAS_EVALUATOR_MODEL=mistral
RAGAS_EMBEDDING_MODEL=nomic-embed-text

TOP_K=3
RETRIEVAL_MIN_SCORE=0.10
LATENCY_THRESHOLD_MS=5000
LLM_TIMEOUT_SECONDS=60

